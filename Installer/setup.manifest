    </dependentAssembly>
  </dependency>
  <asm.v3:application xmlns:asm.v3="urn:schemas-microsoft-com:asm.v3">
    <asm.v3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </asm.v3:windowsSettings>
  </asm.v3:application>
